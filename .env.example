# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to version control.

# --- Required secrets ---------------------------------------------------
# Random secret used to sign session cookies and CSRF tokens.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECUREVAULT_SECRET_KEY=

# Base64-encoded 32-byte (256-bit) AES key used to encrypt files at rest.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECUREVAULT_ENCRYPTION_KEY=

# --- Storage -------------------------------------------------------------
SECUREVAULT_DB_PATH=instance/securevault.db
SECUREVAULT_STORAGE_DIR=storage

# --- Upload policy ---------------------------------------------------------
SECUREVAULT_MAX_FILE_SIZE_MB=10
SECUREVAULT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,txt,csv,docx,zip

# --- Login security --------------------------------------------------------
SECUREVAULT_MAX_FAILED_LOGINS=5
SECUREVAULT_LOCKOUT_MINUTES=15
SECUREVAULT_IP_RATE_LIMIT_ATTEMPTS=10
SECUREVAULT_IP_RATE_LIMIT_WINDOW_MINUTES=5

# --- Argon2id cost parameters ------------------------------------------
SECUREVAULT_ARGON2_TIME_COST=3
SECUREVAULT_ARGON2_MEMORY_COST_KIB=65536
SECUREVAULT_ARGON2_PARALLELISM=4

# --- Session / cookies -----------------------------------------------------
# Must be true whenever served over HTTPS (i.e. always, in production).
SECUREVAULT_COOKIE_SECURE=true
SECUREVAULT_SESSION_LIFETIME_MINUTES=30
SECUREVAULT_ENABLE_HSTS=true

# --- Misc --------------------------------------------------------------
SECUREVAULT_DEBUG=false
